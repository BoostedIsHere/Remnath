{
  "name": "Remnath",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",

      "Modules": {
        "$path": "src/modules"
      },

      "Shared": {
        "$path": "src/shared"
      },

      "CombatEvents": {
        "$className": "Folder",
        "M1Event": {
          "$className": "RemoteEvent"
        },
        "HitmarkerEvent": {
          "$className": "RemoteEvent"
        },
        "BlockEvent": {
          "$className": "RemoteEvent"
        },
        "WeaponHitEvent": {
          "$className": "RemoteEvent"
        }
      },

      "Remotes": {
        "$className": "Folder",
        "DodgeEvent": {
          "$className": "RemoteEvent"
        },
        "BlockEvent": {
          "$className": "RemoteEvent"
        },
        "ParryEvent": {
          "$className": "RemoteEvent"
        }
      },

      "Assets": {
        "$path": "src/server/Assets"
      },

      "Weapons": {
        "$className": "Folder",
        "Fists": {
          "$className": "Tool",

          "WeaponClient": {
            "$path": "src/weapons/fists/WeaponClient.client.luau"
          },

          "Config": {
            "$path": "src/weapons/fists/Config.luau"
          },

          "Handle": {
            "$className": "Part",
            "$properties": {
              "Name": "Handle",
              "Anchored": false,
              "CanCollide": false,
              "Size": [1, 1, 1],
              "Transparency": 0
            },
            "DmgPoint": {
              "$className": "Attachment",
              "$properties": {
                "Name": "DmgPoint",
                "Position": [0, 0, -0.5]
              }
            }
          }
        }
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/server"
      },
      "Controllers": {
        "$path": "src/server/Controllers"
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",

      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$className": "Folder",
          "Controllers": {
            "$path": "src/client/Controllers"
          },
          "Input": {
            "$path": "src/client/Input"
          }
        }
      },

      "StarterCharacterScripts": {
        "$className": "StarterCharacterScripts",
        "$path": "src/character"
      }
    },

    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "FilteringEnabled": true
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Color": [
            0.38823,
            0.37254,
            0.38823
          ],
          "Locked": true,
          "Position": [
            0,
            -10,
            0
          ],
          "Size": [
            512,
            20,
            512
          ]
        }
      }
    },

    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Ambient": [
          0,
          0,
          0
        ],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      }
    },

    "SoundService": {
      "$className": "SoundService",
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
